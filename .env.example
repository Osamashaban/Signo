# Copy to .env.local for local development. Never commit real values.
# Deployed values live in Vercel → Project → Settings → Environment Variables
# (see SETUP.md): Production uses the Neon `main` branch, Preview and
# Development the `staging` branch.

# Secret (server only)
# Neon project signo → Connect → Branch: staging. Pooled for the app, direct for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
RESEND_API_KEY=
REVIEW_LINK_ENCRYPTION_KEY=
EMAIL_FROM="Signo <onboarding@resend.dev>"

# Neon Auth (US-SGN-001). Neon project signo → branch → Auth → "Auth URL".
NEON_AUTH_BASE_URL=
# Any random text of 32+ characters; signs the session cookie. Different per environment.
NEON_AUTH_COOKIE_SECRET=

# Not secret, optional
# The site's own address, used in email links. On Vercel it is worked out automatically.
APP_URL=
# Only for tests: where to send email instead of the real Resend API.
RESEND_API_URL=
